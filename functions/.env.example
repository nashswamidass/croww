# Cloud Functions — server-only secrets. Never bundle into the Expo client.
# Copy to `functions/.env` locally (gitignored). Production Cashfree secrets are
# Google Secret Manager bindings; application code still reads the same
# process.env names. Mailgun stays on plaintext Functions env until a later task.
#
# Optional overlay: `functions/.env.local` (gitignored; Firebase CLI does not
# deploy it). Before a production Functions deploy, do not leave
# CASHFREE_PG_CLIENT_SECRET / CASHFREE_VERIFY_CLIENT_SECRET in `.env` — they
# would be sent as plaintext and collide with Secret Manager.
#
# Staging deploy uses gitignored `.env.croww-staging-2026` to blank these values so
# staging never inherits production Cashfree/Mailgun credentials from `.env`.

SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=your-mailgun-smtp-user
SMTP_FROM=Croww <noreply@example.com>
MAILGUN_API_KEY=your-mailgun-api-key

CASHFREE_PG_CLIENT_ID=your-cashfree-pg-client-id
CASHFREE_PG_CLIENT_SECRET=your-cashfree-pg-client-secret

# Secure ID / Verification (DigiLocker). This is NOT the Payment Gateway App ID.
# Live id paired with Secret Manager CASHFREE_VERIFY_CLIENT_SECRET:
# CF1206869DAII0KUNK84C73FH79NG
CASHFREE_VERIFY_CLIENT_ID=your-cashfree-verification-client-id
CASHFREE_VERIFY_CLIENT_SECRET=your-cashfree-verification-client-secret

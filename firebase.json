{
    "hosting": [
        {
            "site": "croww-app",
            "public": "dist",
            "ignore": [
                "firebase.json",
                "**/.*"
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ]
        },
        {
            "site": "croww-live-2026",
            "public": "dist",
            "ignore": [
                "firebase.json",
                "**/.*"
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ]
        }
    ],
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        }
    ]
}
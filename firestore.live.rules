rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin'
      );
    }

    function clientUserTypeOk() {
      return request.resource.data.get('userType', 'individual')
        == resource.data.get('userType', 'individual');
    }

    function clientVerificationDataOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationData'])
        || request.resource.data.verificationData.status == 'pending';
    }

    // ─── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && !('trust' in request.resource.data)
        && !('roles' in request.resource.data)
        && !('kycDetails' in request.resource.data)
        && !('kycStatus' in request.resource.data)
        && !('kycProvider' in request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('admin' in request.resource.data)
        && request.resource.data.get('userType', 'individual') in ['individual', 'business', 'provider']
        && request.resource.data.get('role', 'individual') != 'admin'
        && request.resource.data.get('aadhaarVerified', false) == false
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.get('isApproved', false) == false
        && request.resource.data.get('isBlocked', false) == false;
      allow update: if isAdmin() || (
        isOwner(userId)
        && clientUserTypeOk()
        && clientVerificationDataOk()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'trust', 'roles', 'isApproved', 'isBlocked', 'isAdmin', 'admin',
          'userType', 'role',
          'aadhaarVerified', 'isVerified', 'aadhaarVerifiedAt',
          'kycStatus', 'kycDetails', 'kycProvider', 'verifiedAt',
          'verificationStatus', 'verificationType'
        ])
      );
      allow delete: if isAdmin();

      match /kyc_private/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      match /friends/{friendId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          isOwner(userId) || request.auth.uid == friendId
        );
      }

      match /preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }

      function isSavedId(value) {
        return value is string && value.size() > 0 && value.size() <= 128;
      }

      match /savedListings/{listingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isSavedId(listingId)
          && request.resource.data.listingId == listingId
          && request.resource.data.kind == 'savedListing'
          && !('matchedAt' in request.resource.data)
          && !('notificationId' in request.resource.data)
          && !('personalScore' in request.resource.data);
      }

      match /savedProperties/{propertyId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isSavedId(propertyId)
          && request.resource.data.propertyId == propertyId
          && request.resource.data.kind == 'savedProperty'
          && !('matchedAt' in request.resource.data)
          && !('notificationId' in request.resource.data)
          && !('personalScore' in request.resource.data);
      }

      match /savedSearches/{searchId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.kind == 'savedSearch'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.criteriaHash is string
          && request.resource.data.alertEnabled is bool
          && !('matchedAt' in request.resource.data)
          && !('notificationId' in request.resource.data)
          && !('personalScore' in request.resource.data)
          && !('areaScore' in request.resource.data);
      }

      match /savedSearchMatches/{matchId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Public identity only. Never copy kycDetails, email, phone, pushToken,
    // admin flags, or verification internals onto this document.
    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(userId) || isAdmin())
        && request.resource.data.kind == 'publicProfile'
        && request.resource.data.get('userType', 'individual') in ['individual', 'business', 'provider']
        && !request.resource.data.keys().hasAny([
          'email', 'phone', 'pushToken',
          'kycDetails', 'kycStatus', 'kycProvider',
          'aadhaarVerified', 'aadhaarVerifiedAt', 'isVerified', 'isApproved',
          'verifiedAt', 'verificationData', 'verificationStatus', 'verificationType',
          'trust', 'roles', 'isAdmin', 'admin'
        ]);
      allow delete: if isAdmin() || isOwner(userId);
    }

    // ─── Events ────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        resource.data.isPublic == true ||
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.organizerId == request.auth.uid;
      // Allow organizers, admins, or users updating ticket capacity counts
      allow update: if isSignedIn() && (
        resource.data.organizerId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingTickets', 'attendeesCount'])
      );
      allow delete: if isSignedIn() && (
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── Tickets ───────────────────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.organizerId == request.auth.uid ||
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'PENDING_PAYMENT' &&
          request.resource.data.status == 'valid' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // ─── Bookings ──────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || isAdmin()
      );
    }

    // ─── App Settings ─────────────────────────────────────────────────────────
    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId.size() > 0
      );
      allow delete: if isSignedIn() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── Chats / Messages ──────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.participantIds);

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn() &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // ─── Buddy Requests ────────────────────────────────────────────────────────
    match /buddyRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }
    match /buddy_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Buddy Join Requests ────────────────────────────────────────────────────
    match /buddy_join_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.requesterId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    // ─── Follows ───────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.followerId == request.auth.uid;
    }

    // ─── Friend requests (used by friendService; screens currently use buddy joins) ─
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.toUserId == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // ─── Services / Packages ───────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.data.providerId == request.auth.uid;
    }

    // ─── Reviews ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── Admins (restricted) ──────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ─── Property domain (isolated from events) ───────────────────────────────
    // Public property/listing docs store PUBLIC map pins only
    // (latitude, longitude, geo, geohash). Exact coordinates live in
    // properties/{id}/private_geo/current. Firestore cannot hide fields on a
    // readable document — do not put exact coords back on public docs.
    function validLatLng() {
      return request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180;
    }

    function sourceNotAuthoritative() {
      return request.resource.data.source.authoritative == false
        && request.resource.data.source.uid == request.auth.uid
        && request.resource.data.source.channel in [
          'USER_CREATED', 'ADMIN_CREATED', 'ADMIN_IMPORTED', 'FUTURE_API', 'FUTURE_BULK_IMPORT'
        ]
        && (request.resource.data.source.channel == 'USER_CREATED' || isAdmin());
    }

    function propertyVerificationUnverified() {
      return request.resource.data.verification.identity.status == 'NOT_VERIFIED'
        && request.resource.data.verification.ownership.status == 'NOT_VERIFIED'
        && request.resource.data.verification.property.status == 'NOT_VERIFIED'
        && request.resource.data.verification.location.status == 'NOT_VERIFIED';
    }

    function listingActorRoleAllowed() {
      return request.resource.data.listedByRole == 'owner'
        || (request.resource.data.listedByRole == 'agent' && userHasPropertyRole('agent'))
        || (request.resource.data.listedByRole == 'builder' && userHasPropertyRole('builder'))
        || (request.resource.data.listedByRole == 'admin' && isAdmin());
    }

    function userHasPropertyRole(role) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['roles'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles is list
        && role in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function canAttachListingToProperty() {
      let prop = get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data;
      return (request.resource.data.listedByRole == 'owner'
          && (prop.ownerUid == request.auth.uid || prop.createdByUid == request.auth.uid))
        || request.resource.data.listedByRole in ['agent', 'builder']
        || (request.resource.data.listedByRole == 'admin' && isAdmin());
    }

    function isPropertyOwnerOrCreator(propertyId) {
      return isSignedIn() && exists(/databases/$(database)/documents/properties/$(propertyId))
        && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/properties/$(propertyId)).data.createdByUid == request.auth.uid
          || isAdmin()
        );
    }

    function hasApprovedLocationShare(propertyId) {
      let shareId = propertyId + '__' + request.auth.uid;
      return isSignedIn()
        && exists(/databases/$(database)/documents/location_shares/$(shareId))
        && get(/databases/$(database)/documents/location_shares/$(shareId)).data.status == 'APPROVED'
        && (
          !('expiresAt' in get(/databases/$(database)/documents/location_shares/$(shareId)).data)
          || get(/databases/$(database)/documents/location_shares/$(shareId)).data.expiresAt == null
          || (
            get(/databases/$(database)/documents/location_shares/$(shareId)).data.expiresAt is timestamp
            && get(/databases/$(database)/documents/location_shares/$(shareId)).data.expiresAt > request.time
          )
        );
    }

    // Clients may keep PUBLISHED or leave it; they cannot introduce PUBLISHED.
    function clientCannotPublishListing() {
      return request.resource.data.status != 'PUBLISHED'
        || resource.data.status == 'PUBLISHED';
    }

    match /properties/{propertyId} {
      allow read: if resource.data.status == 'ACTIVE'
        || (isSignedIn() && (
          resource.data.createdByUid == request.auth.uid
          || resource.data.ownerUid == request.auth.uid
          || isAdmin()
        ));

      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status in ['ACTIVE', 'INACTIVE']
        && request.resource.data.category in ['residential', 'commercial', 'land']
        && validLatLng()
        && sourceNotAuthoritative()
        && propertyVerificationUnverified()
        && request.resource.data.get('spatialTourAvailable', false) == false;

      allow update: if isSignedIn() && (
        isAdmin()
        || (
          (resource.data.createdByUid == request.auth.uid || resource.data.ownerUid == request.auth.uid)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.verification == resource.data.verification
          && request.resource.data.source.authoritative == resource.data.source.authoritative
          && request.resource.data.get('spatialTourAvailable', false) == resource.data.get('spatialTourAvailable', false)
          && validLatLng()
        )
      );

      allow delete: if isAdmin();

      match /private_geo/{docId} {
        allow read: if isPropertyOwnerOrCreator(propertyId)
          || hasApprovedLocationShare(propertyId);
        allow create, update: if isPropertyOwnerOrCreator(propertyId)
          && request.resource.data.latitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180
          && request.resource.data.updatedByUid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'PUBLISHED'
        || (isSignedIn() && (
          resource.data.listedByUid == request.auth.uid
          || resource.data.ownerUid == request.auth.uid
          || isAdmin()
        ));

      allow create: if isSignedIn()
        && request.resource.data.listedByUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.transactionType in ['buy', 'rent']
        && listingActorRoleAllowed()
        && exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
        && canAttachListingToProperty()
        && sourceNotAuthoritative()
        && request.resource.data.lastVerifiedAt == null
        && request.resource.data.publishedAt == null
        && request.resource.data.representationStatus == 'unverified'
        && request.resource.data.get('spatialTourAvailable', false) == false
        && (
          !('verification' in request.resource.data)
          || request.resource.data.verification.representation.status == 'NOT_VERIFIED'
        )
        && validLatLng();

      allow update: if isSignedIn() && (
        isAdmin()
        || (
          resource.data.listedByUid == request.auth.uid
          && request.resource.data.listedByUid == resource.data.listedByUid
          && request.resource.data.listedByRole == resource.data.listedByRole
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.propertyId == resource.data.propertyId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.lastVerifiedAt == resource.data.lastVerifiedAt
          && request.resource.data.get('publishedAt', null) == resource.data.get('publishedAt', null)
          && request.resource.data.source.authoritative == resource.data.source.authoritative
          && request.resource.data.representationStatus == resource.data.representationStatus
          && request.resource.data.get('spatialTourAvailable', false) == resource.data.get('spatialTourAvailable', false)
          && (
            !('verification' in resource.data)
            || request.resource.data.verification == resource.data.verification
          )
          && request.resource.data.latitude == resource.data.latitude
          && request.resource.data.longitude == resource.data.longitude
          && request.resource.data.geohash == resource.data.geohash
          && request.resource.data.localityId == resource.data.localityId
          && request.resource.data.city == resource.data.city
          && request.resource.data.category == resource.data.category
          && request.resource.data.subtype == resource.data.subtype
          && clientCannotPublishListing()
          && request.resource.data.status in [
            'DRAFT', 'PUBLISHED', 'PAUSED', 'SOLD', 'RENTED', 'EXPIRED', 'ARCHIVED'
          ]
        )
      );

      allow delete: if isAdmin();

      match /private_meta/{docId} {
        allow read: if isSignedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/listings/$(listingId)).data.listedByUid == request.auth.uid
          || get(/databases/$(database)/documents/listings/$(listingId)).data.ownerUid == request.auth.uid
        );
        allow create, update: if isSignedIn() && (
          isAdmin()
          || (
            get(/databases/$(database)/documents/listings/$(listingId)).data.listedByUid == request.auth.uid
            && request.resource.data.moderation.status in ['NONE', 'PENDING']
            && request.resource.data.moderation.reviewedByUid == null
            && request.resource.data.updatedByUid == request.auth.uid
          )
        );
        allow delete: if isAdmin();
      }
    }

    match /localities/{localityId} {
      // Public: ACTIVE catalog + current public intelligence snapshot on this doc.
      // Writes including intelligence/stats: admin only. Draft/history/internal: admin only.
      allow read: if resource.data.status == 'ACTIVE' || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /intelligence_draft/{docId} {
        allow read, write: if isAdmin();
      }
      match /intelligence_history/{snapshotId} {
        allow read, write: if isAdmin();
      }
      match /intelligence_internal/{docId} {
        allow read, write: if isAdmin();
      }
    }

    function canCreateParentMedia() {
      let propertyId = request.resource.data.propertyId;
      let parentType = request.resource.data.parentType;
      let parentId = request.resource.data.parentId;
      return exists(/databases/$(database)/documents/properties/$(propertyId))
        && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/properties/$(propertyId)).data.createdByUid == request.auth.uid
          || (
            parentType == 'listing'
            && exists(/databases/$(database)/documents/listings/$(parentId))
            && get(/databases/$(database)/documents/listings/$(parentId)).data.listedByUid == request.auth.uid
          )
        );
    }

    function spatialPublicRead() {
      return resource.data.mediaType == 'spatial'
        && resource.data.status == 'ACTIVE'
        && resource.data.visibility == 'public'
        && resource.data.processingStatus == 'READY';
    }

    function spatialClientCreateOk() {
      return request.resource.data.mediaType != 'spatial'
        || (
          request.resource.data.visibility == 'private'
          && request.resource.data.url == null
          && request.resource.data.processingStatus in ['UPLOADING', 'PROCESSING']
        );
    }

    function spatialClientUpdateOk() {
      return resource.data.mediaType != 'spatial'
        || (
          request.resource.data.mediaType == 'spatial'
          && request.resource.data.processingStatus != 'READY'
          && request.resource.data.visibility != 'public'
          && (request.resource.data.url == resource.data.url || request.resource.data.url == null)
        );
    }

    match /property_media/{mediaId} {
      allow read: if (
        resource.data.status == 'ACTIVE'
        && resource.data.visibility == 'public'
        && resource.data.mediaType in ['photo', 'floor_plan', 'video']
      ) || spatialPublicRead() || (
        isSignedIn() && (
          resource.data.createdByUid == request.auth.uid || isAdmin()
        )
      );

      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.parentType in ['property', 'listing']
        && request.resource.data.mediaType in ['photo', 'floor_plan', 'video', 'document', 'spatial']
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.status in ['ACTIVE', 'HIDDEN']
        && (
          request.resource.data.mediaType != 'document'
          || request.resource.data.visibility == 'private'
        )
        && (
          request.resource.data.visibility != 'public'
          || request.resource.data.mediaType in ['photo', 'floor_plan', 'video']
        )
        && spatialClientCreateOk()
        && canCreateParentMedia();

      allow update: if isSignedIn() && (
        isAdmin()
        || (
          resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.parentType == resource.data.parentType
          && request.resource.data.propertyId == resource.data.propertyId
          && (
            request.resource.data.visibility != 'public'
            || request.resource.data.mediaType in ['photo', 'floor_plan', 'video']
          )
          && spatialClientUpdateOk()
        )
      );

      allow delete: if isAdmin();
    }

    match /spatial_processing_jobs/{jobId} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.submittedByUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.status == 'QUEUED'
        && request.resource.data.mediaId is string
        && request.resource.data.propertyId is string
        && exists(/databases/$(database)/documents/property_media/$(request.resource.data.mediaId))
        && get(/databases/$(database)/documents/property_media/$(request.resource.data.mediaId)).data.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Property trust cases. Evidence paths stay private. Clients create PENDING only.
    match /verification_cases/{caseId} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.submittedByUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.notes == null
        && request.resource.data.type in [
          'OWNER', 'AGENT', 'BUILDER', 'OWNERSHIP', 'REPRESENTATION', 'PROPERTY', 'LOCATION'
        ]
        && request.resource.data.subjectId is string
        && (
          !(request.resource.data.type in ['OWNER', 'AGENT', 'BUILDER'])
          || request.resource.data.subjectId == request.auth.uid
        )
        && request.resource.data.evidenceType in [
          'KYC_REFERENCE', 'OWNERSHIP_DOCUMENT', 'PROPERTY_DOCUMENT', 'COMPANY_DOCUMENT',
          'AUTHORIZATION_DOCUMENT', 'LOCATION_EVIDENCE', 'OTHER'
        ];
      allow update, delete: if false;

      match /history/{eventId} {
        allow read: if isSignedIn() && (
          isAdmin()
          || get(/databases/$(database)/documents/verification_cases/$(caseId)).data.submittedByUid == request.auth.uid
        );
        allow write: if false;
      }
    }

    // Owner-controlled exact location shares
    match /location_shares/{shareId} {
      allow read: if isSignedIn() && (
        resource.data.viewerUid == request.auth.uid
        || resource.data.ownerUid == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.viewerUid == request.auth.uid
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.get('approvedAt', null) == null
        && request.resource.data.get('reviewedByUid', null) == null
        && request.resource.data.get('respondedAt', null) == null
        && shareId == request.resource.data.propertyId + '__' + request.auth.uid
        && exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
        && (
          get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerUid == request.resource.data.ownerUid
          || get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.createdByUid == request.resource.data.ownerUid
        );
      allow update, delete: if isAdmin();
    }

    match /kyc_sessions/{sessionId} {
      allow read, write: if false;
    }

    // ─── Catch-all: deny everything not explicitly allowed ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

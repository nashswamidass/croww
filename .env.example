# Croww Expo app — client-safe public configuration only.
# Copy to `.env` locally. Never commit real `.env` files.
# Server secrets (Cashfree PG secret, verification secret, Mailgun) belong in
# `functions/.env` (untracked) or Google Cloud / Firebase Functions secrets.
# NEVER use EXPO_PUBLIC_* for a true secret. Expo inlines those into the client.

EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:replace-me
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-restricted-maps-key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-oauth-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_CASHFREE_ENV=SANDBOX
EXPO_PUBLIC_CASHFREE_CLIENT_ID=your-cashfree-public-app-id
EXPO_PUBLIC_CASHFREE_APP_URL=https://localhost:8081
EXPO_PUBLIC_SENTRY_DSN=

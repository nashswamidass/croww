rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin'
      );
    }

    // ─── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ─── Events ────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        resource.data.isPublic == true ||
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.organizerId == request.auth.uid;
      // Allow organizers, admins, or users updating ticket capacity counts
      allow update: if isSignedIn() && (
        resource.data.organizerId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingTickets', 'attendeesCount'])
      );
      allow delete: if isSignedIn() && (
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── Tickets ───────────────────────────────────────────────────────────────
    match /tickets/{ticketId} {
      // Single doc read (e.g. ticket detail, QR scan)
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      // Allow organizer to update status (scan), and user to do nothing.
      allow update: if isSignedIn() && (
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── Bookings ──────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || isAdmin()
      );
    }

    // ─── App Settings ─────────────────────────────────────────────────────────
    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── Chats / Messages ──────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.participantIds);

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn() &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // ─── Buddy Requests ────────────────────────────────────────────────────────
    match /buddyRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
    }
    match /buddy_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Buddy Join Requests ────────────────────────────────────────────────────
    match /buddy_join_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.requesterId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    // ─── Follows ───────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn();
    }

    // ─── Services / Packages ───────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.data.providerId == request.auth.uid;
    }

    // ─── Reviews ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── Admins (restricted) ──────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ─── Catch-all: deny everything not explicitly allowed ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
